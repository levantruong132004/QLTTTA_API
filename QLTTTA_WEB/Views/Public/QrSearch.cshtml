@model List<QLTTTA_WEB.Models.AdminRegistrationItem>
@{
    ViewData["Title"] = "Kết quả tra cứu QR";
}
<div class="retro-card">
    <div class="retro-card-header d-flex justify-content-between align-items-center">
        <h2 class="retro-title"><i class="fas fa-search"></i> Kết quả tra cứu QR</h2>
        <div>
            <a href="@Url.Action("Login","Account", new { returnUrl = Url.Action("QrSearch","Manage", new { q = (string?)ViewBag.Query }) })" class="btn btn-outline-primary">
                <i class="fas fa-sign-in-alt"></i> Đăng nhập để thao tác
            </a>
        </div>
    </div>
    <div class="retro-card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            </div>
        }
        <div class="mb-3">
            <label class="form-label">Nội dung tra cứu:</label>
            <div class="alert alert-info" style="overflow:auto; white-space:nowrap">
                @((string?)ViewBag.Query ?? "")
            </div>
        </div>
        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-warning">
                <i class="fas fa-info-circle"></i> Không tìm thấy đăng ký phù hợp.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Mã đăng ký</th>
                            <th>Học viên</th>
                            <th>Lớp</th>
                            <th>Khóa học</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.RegistrationId</td>
                                <td>@r.RegistrationCode</td>
                                <td>ID: @r.StudentId</td>
                                <td>@r.ClassName</td>
                                <td>@r.CourseName</td>
                                <td>
                                    <span class="badge bg-warning text-dark">@r.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                <a href="@Url.Action("Login","Account", new { returnUrl = Url.Action("QrSearch","Manage", new { q = (string?)ViewBag.Query }) })" class="btn btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Đăng nhập để duyệt / thao tác
                </a>
            </div>
        }
    </div>
</div>

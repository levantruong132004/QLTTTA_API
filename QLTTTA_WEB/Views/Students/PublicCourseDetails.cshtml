@model QLTTTA_WEB.Models.CourseViewModel
@{
    ViewData["Title"] = "Thông tin khóa học";
}
<div class="retro-card">
    <div class="retro-card-header">
        <h2 class="retro-title"><i class="fas fa-qrcode"></i> Thông tin khóa học</h2>
    </div>
    <div class="retro-card-body">
        @if (Model == null)
        {
            <div class="alert alert-warning">Không tìm thấy khóa học.</div>
        }
        else
        {
            <dl class="row mb-0">
                <dt class="col-sm-3">Mã khóa học</dt>
                <dd class="col-sm-9">@Model.CourseCode</dd>

                <dt class="col-sm-3">Tên khóa học</dt>
                <dd class="col-sm-9">@Model.CourseName</dd>

                <dt class="col-sm-3">Mô tả</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Học phí chuẩn</dt>
                <dd class="col-sm-9">@Model.StandardFee.ToString("N0") đ</dd>
            </dl>
        }
    </div>
</div>
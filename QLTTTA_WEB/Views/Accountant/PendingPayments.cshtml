@model List<QLTTTA_WEB.Models.PendingPaymentViewModel>
@{
    ViewData["Title"] = "Quản lý thanh toán chờ xác nhận";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #e9d3c3 0%, #A0522D 100%); color: white;">
                    <h4 class="mb-0">
                        <i class="fas fa-credit-card me-2"></i>
                        Thanh toán chờ xác nhận
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model != null && Model.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Có <strong>@Model.Count</strong> thanh toán đang chờ xác nhận từ học viên.
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Mã hóa đơn</th>
                                        <th>Học viên</th>
                                        <th>Khóa học</th>
                                        <th>Số tiền</th>
                                        <th>Ngày gửi</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="text-primary">@item.InvoiceCode</strong><br>
                                                <small class="text-muted">@item.RegistrationCode</small>
                                            </td>
                                            <td>
                                                <strong>@item.StudentName</strong>
                                            </td>
                                            <td>@item.CourseName</td>
                                            <td>
                                                <span class="badge bg-success fs-6">
                                                    @item.Amount.ToString("N0") VNĐ
                                                </span>
                                            </td>
                                            <td>
                                                @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td class="text-center">
                                                <form method="post" asp-action="ConfirmPayment" style="display: inline;">
                                                    <input type="hidden" name="invoiceId" value="@item.InvoiceId" />
                                                    <button type="button" class="btn btn-success btn-sm" 
                                                            onclick="confirmPayment(@item.InvoiceId, '@item.StudentName', '@item.InvoiceCode')">
                                                        <i class="fas fa-check me-1"></i>
                                                        Xác nhận
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-credit-card fa-4x text-muted"></i>
                            </div>
                            <h5 class="text-muted">Không có thanh toán nào đang chờ xác nhận</h5>
                            <p class="text-muted">Tất cả các thanh toán đã được xử lý.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-question-circle text-warning me-2"></i>
                    Xác nhận thanh toán
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xác nhận thanh toán cho:</p>
                <div class="alert alert-info">
                    <strong>Học viên:</strong> <span id="studentName"></span><br>
                    <strong>Hóa đơn:</strong> <span id="invoiceCode"></span>
                </div>
                <p class="text-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Sau khi xác nhận, hóa đơn sẽ chuyển sang trạng thái "Đã thanh toán" và không thể hoàn tác.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Hủy
                </button>
                <form method="post" asp-action="ConfirmPayment" id="confirmForm" style="display: inline;">
                    <input type="hidden" name="invoiceId" id="confirmInvoiceId" />
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check me-1"></i>Xác nhận thanh toán
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmPayment(invoiceId, studentName, invoiceCode) {
            document.getElementById('studentName').textContent = studentName;
            document.getElementById('invoiceCode').textContent = invoiceCode;
            document.getElementById('confirmInvoiceId').value = invoiceId;
            
            var modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            modal.show();
        }

        // Auto-refresh mỗi 30 giây để cập nhật danh sách mới
        setInterval(function() {
            location.reload();
        }, 30000);
    </script>
}
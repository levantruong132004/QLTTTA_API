@model QLTTTA_WEB.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="register-container" style="max-width:520px;margin:30px auto;">
    <div class="retro-form corner-decorated">
        <h2 class="vintage-title"><i class="fas fa-key"></i> Quên mật khẩu</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="retro-alert retro-alert-danger"><div class="retro-alert-content">@TempData["ErrorMessage"]</div></div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="retro-alert retro-alert-info"><div class="retro-alert-content">@TempData["InfoMessage"]</div></div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group-retro">
                <label asp-for="Username" class="form-label-retro"><i class="fas fa-user"></i> Tên tài khoản</label>
                <input asp-for="Username" class="form-control-retro" />
                <span asp-validation-for="Username" class="text-validation-error"></span>
            </div>
            <div class="form-group-retro">
                <label asp-for="Email" class="form-label-retro"><i class="fas fa-envelope"></i> Email</label>
                <input asp-for="Email" class="form-control-retro" />
                <span asp-validation-for="Email" class="text-validation-error"></span>
            </div>
            <button type="submit" class="btn-retro btn-retro-primary" style="width:100%"><i class="fas fa-paper-plane"></i> Gửi OTP</button>
        </form>
        <div class="login-link" style="margin-top: 1rem; text-align:center">
            <a asp-action="Login"><i class="fas fa-arrow-left"></i> Quay lại đăng nhập</a>
        </div>
    </div>
</div>

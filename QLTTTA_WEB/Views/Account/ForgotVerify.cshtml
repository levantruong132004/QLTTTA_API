@model QLTTTA_WEB.Models.ForgotVerifyViewModel
@{
    ViewData["Title"] = "Xác thực OTP - Đặt lại mật khẩu";
}

<div class="register-container" style="max-width:520px;margin:30px auto;">
    <div class="retro-form corner-decorated">
        <h2 class="vintage-title"><i class="fas fa-shield-alt"></i> Nhập OTP và mật khẩu mới</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="retro-alert retro-alert-danger"><div class="retro-alert-content">@TempData["ErrorMessage"]</div></div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="retro-alert retro-alert-info"><div class="retro-alert-content">@TempData["InfoMessage"]</div></div>
        }

        <form asp-action="ForgotVerify" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CorrelationId" />
            <div class="form-group-retro">
                <label asp-for="Otp" class="form-label-retro"><i class="fas fa-hashtag"></i> Mã OTP</label>
                <input asp-for="Otp" class="form-control-retro" />
                <span asp-validation-for="Otp" class="text-validation-error"></span>
            </div>
            <div class="form-group-retro">
                <label asp-for="NewPassword" class="form-label-retro"><i class="fas fa-lock"></i> Mật khẩu mới</label>
                <input asp-for="NewPassword" class="form-control-retro" type="password" />
                <span asp-validation-for="NewPassword" class="text-validation-error"></span>
            </div>
            <div class="form-group-retro">
                <label asp-for="ConfirmNewPassword" class="form-label-retro"><i class="fas fa-lock"></i> Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmNewPassword" class="form-control-retro" type="password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-validation-error"></span>
            </div>
            <button type="submit" class="btn-retro btn-retro-primary" style="width:100%"><i class="fas fa-check"></i> Xác nhận</button>
        </form>
        <div class="login-link" style="margin-top: 1rem; text-align:center">
            <a asp-action="Login"><i class="fas fa-arrow-left"></i> Quay lại đăng nhập</a>
        </div>
    </div>
</div>

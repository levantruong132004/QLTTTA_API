@model QLTTTA_WEB.Models.AdminClassItem
@{
    ViewData["Title"] = "Sửa lớp học";
}
<div class="retro-card">
    <div class="retro-card-header">
        <h2 class="retro-title"><i class="fas fa-edit"></i> Sửa lớp học</h2>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form asp-action="EditClass" method="post" class="row g-3">
            <input type="hidden" name="classId" value="@Model.ClassId" />
            <div class="col-md-3">
                <label class="form-label">Mã lớp</label>
                <input type="text" name="classCode" value="@Model.ClassCode" class="form-control" required />
            </div>
            <div class="col-md-5">
                <label class="form-label">Tên lớp</label>
                <input type="text" name="className" value="@Model.ClassName" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Sĩ số tối đa</label>
                <input type="number" name="maxSize" value="@Model.MaxSize" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Khóa học (ID)</label>
                <input type="number" name="courseId" value="@Model.CourseId" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Giáo viên (ID)</label>
                <input type="number" name="teacherId" value="@Model.TeacherId" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Ngày bắt đầu</label>
                <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")"
                    class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Ngày kết thúc</label>
                <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control"
                    required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Trạng thái</label>
                @{
                    var statuses = new[] { "Đang tuyển sinh", "Đã bắt đầu", "Đã hủy", "Đã kết thúc", "Đã đủ sĩ số" };
                }
                <select name="status" class="form-select">
                    @foreach (var s in statuses)
                    {
                        if (string.Equals(Model?.Status, s, StringComparison.Ordinal))
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12">
                <button class="btn btn-primary">Lưu</button>
                <a class="btn btn-secondary" asp-action="Classes">Quay lại</a>
            </div>
        </form>
    </div>
</div>
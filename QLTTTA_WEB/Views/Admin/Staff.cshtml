@model List<QLTTTA_WEB.Models.StaffAdminItem>
@{
    ViewData["Title"] = "Quản lý nhân viên";
}
<div class="retro-card corner-decorated">
    <div class="retro-card-header text-center">
        <h2 class="retro-card-title"><i class="fas fa-users"></i> Quản lý nhân viên</h2>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="retro-alert retro-alert-success"><div class="retro-alert-content">@TempData["SuccessMessage"]</div></div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="retro-alert retro-alert-danger"><div class="retro-alert-content">@TempData["ErrorMessage"]</div></div>
        }

        <div class="mb-3">
            <a asp-action="CreateStaffPage" class="btn btn-success"><i class="fas fa-plus"></i> Tạo nhân viên mới</a>
        </div>

        <h5 class="mb-2">Danh sách nhân viên</h5>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên đăng nhập</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Họ tên</th>
                        <th>Giới tính</th>
                        <th>SĐT</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.UserId</td>
                                <td>@s.Username</td>
                                <td>@s.Email</td>
                                <td>
                                    @if(s.RoleId == 4) { <span>Nhân viên học vụ</span> }
                                    else if(s.RoleId == 3) { <span>Kế toán</span> }
                                    else { <span>@s.RoleName</span> }
                                </td>
                                <td>@s.FullName</td>
                                <td>@s.Sex</td>
                                <td>@s.Phone</td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Đã khóa</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="EditStaffPage" asp-route-id="@s.UserId" class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></a>
                                        
                                        @if (s.IsActive)
                                        {
                                            <form asp-action="LockStaff" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@s.UserId" />
                                                <button type="submit" class="btn btn-sm btn-warning" title="Khóa tài khoản"><i class="fas fa-lock"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnlockStaff" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@s.UserId" />
                                                <button type="submit" class="btn btn-sm btn-success" title="Mở khóa tài khoản"><i class="fas fa-unlock"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" class="text-center text-muted">Chưa có dữ liệu</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model List<QLTTTA_WEB.Models.StaffAdminItem>
@{
    ViewData["Title"] = "Quản lý nhân viên";
}
<div class="retro-card corner-decorated">
    <div class="retro-card-header text-center">
        <h2 class="retro-card-title"><i class="fas fa-users"></i> Quản lý nhân viên</h2>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="retro-alert retro-alert-success"><div class="retro-alert-content">@TempData["SuccessMessage"]</div></div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="retro-alert retro-alert-danger"><div class="retro-alert-content">@TempData["ErrorMessage"]</div></div>
        }

        <h5 class="mb-2">Tạo nhân viên mới</h5>
        <form asp-action="CreateStaff" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-2">
                <input class="form-control" name="Username" placeholder="Tên đăng nhập" required />
            </div>
            <div class="col-md-2">
                <input class="form-control" type="password" name="Password" placeholder="Mật khẩu" required />
            </div>
            <div class="col-md-3">
                <input class="form-control" name="Email" placeholder="Email" required />
            </div>
            <div class="col-md-2">
                <select class="form-select" name="RoleId">
                    <option value="4">Nhân viên học vụ</option>
                    <option value="3">Kế toán</option>
                </select>
            </div>
            <div class="col-md-3">
                <input class="form-control" name="FullName" placeholder="Họ tên (tuỳ chọn)" />
            </div>
            <div class="col-md-2">
                <input class="form-control" name="EmployeeCode" placeholder="Mã NV (tuỳ chọn)" />
            </div>
            <div class="col-md-2">
                <input class="form-control" name="Sex" placeholder="Giới tính (tuỳ chọn)" />
            </div>
            <div class="col-md-2">
                <input class="form-control" name="Phone" placeholder="SĐT (tuỳ chọn)" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100"><i class="fas fa-plus"></i> Tạo</button>
            </div>
        </form>

        <hr />
        <h5 class="mb-2">Danh sách nhân viên</h5>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên đăng nhập</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Họ tên</th>
                        <th>Giới tính</th>
                        <th>SĐT</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.UserId</td>
                                <td>@s.Username</td>
                                <td>
                                    <input class="form-control form-control-sm" name="Email" value="@s.Email" form="upd-@s.UserId" />
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" name="RoleId" form="upd-@s.UserId">
                                        <option value="4" selected="@(s.RoleId==4)">Nhân viên học vụ</option>
                                        <option value="3" selected="@(s.RoleId==3)">Kế toán</option>
                                    </select>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" name="FullName" value="@s.FullName" form="upd-@s.UserId" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" name="Sex" value="@s.Sex" form="upd-@s.UserId" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" name="Phone" value="@s.Phone" form="upd-@s.UserId" />
                                </td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Đã khóa</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <form id="upd-@s.UserId" asp-action="UpdateStaff" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="UserId" value="@s.UserId" />
                                            <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-save"></i></button>
                                        </form>
                                        @if (s.IsActive)
                                        {
                                            <form asp-action="LockStaff" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@s.UserId" />
                                                <button type="submit" class="btn btn-sm btn-warning"><i class="fas fa-lock"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnlockStaff" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@s.UserId" />
                                                <button type="submit" class="btn btn-sm btn-success"><i class="fas fa-unlock"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" class="text-center text-muted">Chưa có dữ liệu</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Quét/Tra cứu QR đơn đăng ký";
}
<div class="retro-card">
    <div class="retro-card-header d-flex justify-content-between align-items-center">
        <h2 class="retro-title"><i class="fas fa-qrcode"></i> Quét/Tra cứu QR đơn đăng ký</h2>
        @{
            var returnUrl = (string?)ViewBag.ReturnUrl;
        }
        @if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            <a href="@returnUrl" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
        }
        else
        {
            <a asp-controller="Manage" asp-action="Registrations" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        }
    </div>
    <div class="retro-card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="mb-3">
            <label for="qrInput" class="form-label">Nhập mã/QR nội dung thủ công (REG:, REGID:, CLASS: hoặc mã lớp, JSON):</label>
            <div class="input-group">
                <input type="text" class="form-control" id="qrInput" placeholder="VD: REG:DK2025-0001 | REGID:123 | CLASS:LH00001 | LH00001 | {\"registrationCode\":\"...\"}">
                <button class="btn btn-primary" type="button" onclick="submitQuery()"><i class="fas fa-search"></i> Tra cứu</button>
                <button class="btn btn-outline-secondary" type="button" onclick="openQr()"><i class="fas fa-qrcode"></i> Tạo QR</button>
            </div>
            <small class="text-muted">
                - REG:<em>MÃ_ĐĂNG_KÝ</em> hoặc REGID:<em>ID</em> để tìm đơn đăng ký cụ thể. <br/>
                - CLASS:<em>MÃ_LỚP</em> hoặc nhập trực tiếp mã lớp (VD: LH00001) để liệt kê đăng ký. Mặc định ưu tiên trạng thái "Chờ duyệt"; nếu không có sẽ hiện tất cả trạng thái.
            </small>
        </div>

        <hr />
        <h5 class="mb-2"><i class="fas fa-camera"></i> Dùng camera để quét</h5>
        <p class="text-muted">Nhấn "Mở camera" và cho phép quyền truy cập. Đưa mã QR vào khung, quét thành công sẽ tự chuyển đến trang kết quả.</p>
        <div class="d-flex align-items-center gap-2 mb-2">
            <select id="cameraSelect" class="form-select" style="max-width: 320px; display: none;"></select>
            <button id="startCamBtn" type="button" class="btn btn-outline-primary"><i class="fas fa-video"></i> Mở camera</button>
            <button id="stopCamBtn" type="button" class="btn btn-outline-secondary" disabled><i class="fas fa-stop-circle"></i> Tắt camera</button>
        </div>
        <div id="reader" style="max-width: 500px;"></div>
        <div id="scanStatus" class="mt-2 text-muted"></div>

        <hr />
        <h5 class="mb-2"><i class="fas fa-image"></i> Hoặc tải ảnh QR để tra cứu</h5>
        <p class="text-muted">Kéo thả hoặc chọn ảnh có mã QR, hệ thống sẽ đọc và chuyển trang.</p>
        <input type="file" id="qrFile" accept="image/*" class="form-control" />
        <div id="fileStatus" class="mt-2 text-muted"></div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" defer></script>
    <script>
        function submitQuery() {
            const q = document.getElementById('qrInput').value || '';
            if (!q.trim()) {
                alert('Vui lòng nhập nội dung để tra cứu.');
                return;
            }
            const params = new URLSearchParams();
            params.set('q', q);
            const ru = '@((string?)ViewBag.ReturnUrl ?? "")';
            if (ru) params.set('returnUrl', ru);
            window.location.href = '@Url.Action("QrSearch", "Manage")' + '?' + params.toString();
        }

        function openQr() {
            const q = document.getElementById('qrInput').value || '';
            if (!q.trim()) { alert('Nhập nội dung trước khi tạo mã QR.'); return; }
            // Build a full public URL that opens the search results directly on mobile
            const base = (window.publicBaseUrl && window.publicBaseUrl.trim()) || window.location.origin;
            const target = new URL('@Url.Action("QrSearch", "Public")', base);
            target.searchParams.set('q', q);
            const ru = '@((string?)ViewBag.ReturnUrl ?? "")';
            if (ru) target.searchParams.set('returnUrl', ru);
            // Render a QR image that encodes the absolute URL
            const url = '@Url.Action("QrImage", "Manage")' + '?payload=' + encodeURIComponent(target.toString()) + '&size=480';
            window.open(url, '_blank');
        }

        window.addEventListener('load', function() {
            const status = document.getElementById('scanStatus');
            const startBtn = document.getElementById('startCamBtn');
            const stopBtn = document.getElementById('stopCamBtn');
            const selectEl = document.getElementById('cameraSelect');
            if (!window.Html5Qrcode) {
                status.textContent = 'Không tải được thư viện quét QR.';
                startBtn.disabled = true;
                return;
            }

            const qrRegionId = 'reader';
            const html5QrCode = new Html5Qrcode(qrRegionId);
            // Tăng vùng quét + dùng detector của trình duyệt nếu hỗ trợ để bắt mã nhạy hơn
            const config = {
                fps: 15,
                qrbox: { width: 360, height: 360 },
                aspectRatio: 1.0,
                disableFlip: true,
                formatsToSupport: [window.Html5QrcodeSupportedFormats?.QR_CODE ?? 0],
                experimentalFeatures: { useBarCodeDetectorIfSupported: true }
            };
            let devicesCache = [];
            let running = false;

            function onScanSuccess(qrText) {
                // Stop and navigate to results
                html5QrCode.stop().then(() => {
                    running = false;
                    startBtn.disabled = false;
                    stopBtn.disabled = true;
                    const params = new URLSearchParams();
                    let value = qrText || '';
                    try {
                        const u = new URL(value);
                        const inner = u.searchParams.get('q');
                        if (inner) value = inner;
                    } catch {}
                    params.set('q', value);
                    const ru = '@((string?)ViewBag.ReturnUrl ?? "")';
                    if (ru) params.set('returnUrl', ru);
                    window.location.href = '@Url.Action("QrSearch", "Manage")' + '?' + params.toString();
                });
            }

            function onScanFailure(_) {
                // ignore continuous errors
            }

            function populateCameras(devices) {
                devicesCache = devices || [];
                if (!devicesCache.length) {
                    status.textContent = 'Không tìm thấy camera.';
                    startBtn.disabled = true;
                    return;
                }
                // Show selector if multiple
                if (devicesCache.length > 1) {
                    selectEl.style.display = '';
                    selectEl.innerHTML = devicesCache.map(d => `<option value="${d.id}">${d.label || 'Camera'}</option>`).join('');
                } else {
                    selectEl.style.display = 'none';
                }
                startBtn.disabled = false;
                status.textContent = 'Sẵn sàng. Nhấn "Mở camera" để bắt đầu.';
            }

            Html5Qrcode.getCameras()
                .then(populateCameras)
                .catch(err => {
                    status.textContent = 'Lỗi khi truy cập camera: ' + err + '. Hãy cấp quyền camera cho trình duyệt (Site settings).';
                    startBtn.disabled = false; // cho phép thử lại
                });

            async function startCamera() {
                if (running) return;
                try {
                    status.textContent = 'Đang mở camera…';
                    // Prefer selected deviceId; if not available, try facingMode to trigger permission prompt
                    let chosen = (selectEl.style.display !== 'none' && selectEl.value) ? selectEl.value : (devicesCache[0]?.id);
                    let source = chosen ? chosen : { facingMode: 'environment' };
                    await html5QrCode.start(source, config, onScanSuccess, onScanFailure);
                    running = true;
                    startBtn.disabled = true;
                    stopBtn.disabled = false;
                    status.textContent = 'Đang quét… đưa mã QR vào khung.';
                } catch (err) {
                    // Retry with user-facing camera if env fails and no deviceId known
                    if (!devicesCache.length) {
                        try {
                            await html5QrCode.start({ facingMode: 'user' }, config, onScanSuccess, onScanFailure);
                            running = true;
                            startBtn.disabled = true;
                            stopBtn.disabled = false;
                            status.textContent = 'Đang quét… đưa mã QR vào khung.';
                            return;
                        } catch {}
                    }
                    status.textContent = 'Không thể mở camera: ' + err + '. Nếu đã chặn, vào quyền trang (Site settings) bật Camera rồi bấm "Mở camera" lại.';
                }
            }

            async function stopCamera() {
                if (!running) return;
                try {
                    await html5QrCode.stop();
                } catch {}
                running = false;
                startBtn.disabled = false;
                stopBtn.disabled = true;
                status.textContent = 'Đã tắt camera.';
            }

            startBtn.addEventListener('click', startCamera);
            stopBtn.addEventListener('click', stopCamera);

            // File scanning
            const fileInput = document.getElementById('qrFile');
            const fileStatus = document.getElementById('fileStatus');
            fileInput?.addEventListener('change', async (e) => {
                const file = e.target.files && e.target.files[0];
                if (!file) return;
                try {
                    fileStatus.textContent = 'Đang đọc ảnh…';
                    const text = await html5QrCode.scanFile(file, true);
                    const params = new URLSearchParams();
                    let value = text || '';
                    try {
                        const u = new URL(value);
                        const inner = u.searchParams.get('q');
                        if (inner) value = inner;
                    } catch {}
                    params.set('q', value);
                    const ru = '@((string?)ViewBag.ReturnUrl ?? "")';
                    if (ru) params.set('returnUrl', ru);
                    window.location.href = '@Url.Action("QrSearch", "Manage")' + '?' + params.toString();
                } catch (err) {
                    fileStatus.textContent = 'Không đọc được mã QR từ ảnh: ' + err;
                }
            });
        });
    </script>
}

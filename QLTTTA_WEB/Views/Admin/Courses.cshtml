@model IEnumerable<QLTTTA_WEB.Models.CourseViewModel>
@{
    ViewData["Title"] = "Quản lý khóa học";
}
<div class="retro-card">
    <div class="retro-card-header d-flex justify-content-between align-items-center">
        <h2 class="retro-title"><i class="fas fa-book"></i> Quản lý khóa học</h2>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="mb-3 text-end">
            <a asp-action="CreateCourse" class="btn btn-success"><i class="fas fa-plus-circle"></i> Thêm khóa học mới</a>
        </div>

        <div class="vintage-divider"></div>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Mô tả</th>
                    <th>Học phí</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CourseCode</td>
                        <td>@c.CourseName</td>
                        <td>@c.Description</td>
                        <td>@c.StandardFee.ToString("N0")</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-primary" asp-action="EditCoursePage" asp-route-id="@c.CourseId">Sửa</a>
                            <form asp-action="DeleteCourse" method="post" class="d-inline"
                                onsubmit="return confirm('Xóa khóa này?');">
                                <input type="hidden" name="courseId" value="@c.CourseId" />
                                <button class="btn btn-sm btn-danger">Xóa</button>
                            </form>
                            <button type="button" class="btn btn-sm btn-info ms-1"
                                onclick="generateQrCode('@c.CourseId', this)">Tạo QR</button>
                        </td>
                    </tr>
                    <tr id="qr-row-@c.CourseId" style="display:none;">
                        <td colspan="5">
                            <div class="d-flex align-items-center">
                                <div id="qrcode-@c.CourseId"></div>
                                <div class="ms-3 small text-muted">Quét mã để xem thông tin khóa học công khai</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        function generateQrCode(courseId, btn) {
            var row = document.getElementById('qr-row-' + courseId);
            var container = document.getElementById('qrcode-' + courseId);
            if (row.style.display === 'none') {
                container.innerHTML = '';
                var base = (window.publicBaseUrl && window.publicBaseUrl.length > 0) ? window.publicBaseUrl.replace(/\/$/, '') : window.location.origin;
                var url = base + '/Students/CourseDetails/' + courseId;
                new QRCode(container, { text: url, width: 160, height: 160 });
                row.style.display = 'table-row';
                if (btn) btn.textContent = 'Ẩn QR';
            } else {
                row.style.display = 'none';
                if (btn) btn.textContent = 'Tạo QR';
            }
        }
    </script>
}
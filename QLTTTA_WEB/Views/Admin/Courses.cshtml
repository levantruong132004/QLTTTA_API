@model IEnumerable<QLTTTA_WEB.Models.CourseViewModel>
@{
    ViewData["Title"] = "Quản lý khóa học";
}
<div class="retro-card">
    <div class="retro-card-header">
        <h2 class="retro-title"><i class="fas fa-book"></i> Quản lý khóa học</h2>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form asp-action="CreateCourse" method="post" class="row g-2">
            <div class="col-md-2"><input name="courseCode" class="form-control" placeholder="Mã khóa" required /></div>
            <div class="col-md-3"><input name="courseName" class="form-control" placeholder="Tên khóa" required /></div>
            <div class="col-md-4"><input name="description" class="form-control" placeholder="Mô tả" /></div>
            <div class="col-md-2"><input name="standardFee" type="number" min="0" class="form-control"
                    placeholder="Học phí" required /></div>
            <div class="col-md-1"><button type="submit" class="btn btn-success w-100">Thêm</button></div>
        </form>

        <div class="vintage-divider"></div>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Mô tả</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CourseCode</td>
                        <td>@c.CourseName</td>
                        <td>@c.Description</td>
                        <td class="text-nowrap">
                            <form asp-action="EditCourse" method="post" class="d-inline">
                                <input type="hidden" name="courseId" value="@c.CourseId" />
                                <input type="text" name="courseCode" value="@c.CourseCode" class="form-control d-inline"
                                    style="width:120px;display:inline-block;" />
                                <input type="text" name="courseName" value="@c.CourseName" class="form-control d-inline"
                                    style="width:160px;display:inline-block;" />
                                <input type="text" name="description" value="@c.Description" class="form-control d-inline"
                                    style="width:200px;display:inline-block;" />
                                <input type="number" name="standardFee" value="@c.StandardFee" class="form-control d-inline"
                                    style="width:120px;display:inline-block;" />
                                <button class="btn btn-sm btn-primary">Lưu</button>
                            </form>
                            <form asp-action="DeleteCourse" method="post" class="d-inline"
                                onsubmit="return confirm('Xóa khóa này?');">
                                <input type="hidden" name="courseId" value="@c.CourseId" />
                                <button class="btn btn-sm btn-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
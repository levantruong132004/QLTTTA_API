@model IEnumerable<QLTTTA_WEB.Models.AdminClassItem>
@{
    ViewData["Title"] = "Quản lý lớp học";
}
<div class="retro-card">
    <div class="retro-card-header">
        <h2 class="retro-title"><i class="fas fa-chalkboard"></i> Quản lý lớp học</h2>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form asp-action="Classes" method="get" class="row g-2 mb-3">
            <div class="col-md-3"><input name="courseId" class="form-control" placeholder="Lọc theo ID khóa học"
                    value="@ViewBag.CourseId" /></div>
            <div class="col-md-1"><button class="btn btn-primary w-100">Lọc</button></div>
        </form>

        <form asp-action="CreateClass" method="post" class="row g-2">
            <div class="col-md-2"><input name="classCode" class="form-control" placeholder="Mã lớp" required /></div>
            <div class="col-md-3"><input name="className" class="form-control" placeholder="Tên lớp" required /></div>
            <div class="col-md-2"><input name="startDate" type="date" class="form-control" required /></div>
            <div class="col-md-2"><input name="endDate" type="date" class="form-control" required /></div>
            <div class="col-md-1"><input name="maxSize" type="number" class="form-control" placeholder="Sĩ số"
                    required /></div>
            <div class="col-md-1"><input name="courseId" type="number" class="form-control" placeholder="Khóa"
                    required /></div>
            <div class="col-md-1"><input name="teacherId" type="number" class="form-control" placeholder="GV"
                    required /></div>
            <div class="col-md-1"><button type="submit" class="btn btn-success w-100">Thêm</button></div>
        </form>

        <div class="vintage-divider"></div>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Khóa</th>
                    <th>Ngày</th>
                    <th>Sĩ số</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.ClassCode</td>
                            <td>@c.ClassName</td>
                            <td>@c.CourseId</td>
                            <td>@(c.StartDate?.ToString("dd/MM/yyyy")) - @(c.EndDate?.ToString("dd/MM/yyyy"))</td>
                            <td>@c.MaxSize</td>
                            <td>@(c.Status ?? "-")</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-primary" asp-action="EditClassPage" asp-route-id="@c.ClassId">Sửa</a>
                                <form asp-action="DeleteClass" method="post" class="d-inline"
                                    onsubmit="return confirm('Xóa lớp này?');">
                                    <input type="hidden" name="classId" value="@c.ClassId" />
                                    <input type="hidden" name="courseId" value="@ViewBag.CourseId" />
                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* Dynamic helper functions removed after strong typing *@
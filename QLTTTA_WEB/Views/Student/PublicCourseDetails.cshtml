@model QLTTTA_WEB.Models.CourseViewModel

@{
    ViewData["Title"] = "Thông tin khóa học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h2 class="mb-0"><i class="bi bi-book-half me-2"></i>@Model.CourseName</h2>
                    <p class="mb-0 mt-2 opacity-75">Mã khóa học: @Model.CourseCode</p>
                </div>
                <div class="card-body p-5">
                    <div class="mb-4">
                        <h5 class="text-muted text-uppercase small fw-bold mb-3">Mô tả khóa học</h5>
                        <p class="lead">@Model.Description</p>
                    </div>

                    <hr class="my-4" />

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5 class="text-muted text-uppercase small fw-bold mb-2">Học phí</h5>
                            <h3 class="text-success fw-bold">@Model.StandardFee.ToString("N0") VNĐ</h3>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <h5 class="text-muted text-uppercase small fw-bold mb-2">Trạng thái</h5>
                            <span class="badge bg-success rounded-pill px-3 py-2">Đang tuyển sinh</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-5">
                        @if (Context.Session.GetString("UserId") != null)
                        {
                             <form asp-controller="Student" asp-action="RegisterCourse" method="post">
                                <input type="hidden" name="courseCode" value="@Model.CourseCode" />
                                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                                    <i class="bi bi-pencil-square me-2"></i>Đăng ký khóa học này
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info text-center mb-3">
                                <i class="bi bi-info-circle me-2"></i>Vui lòng đăng nhập để đăng ký khóa học này.
                            </div>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập ngay
                            </a>
                        }
                        <a href="/" class="btn btn-link text-muted mt-2">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@model QLTTTA_WEB.Models.StudentInvoiceDetailViewModel
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<div class="retro-card corner-decorated">
    <div class="retro-card-header text-center">
        <h2 class="retro-card-title"><i class="fas fa-file-invoice"></i> Chi tiết hóa đơn</h2>
    </div>
    <div class="retro-card-body">
        @* Chỉ hiển thị lỗi nếu không có dữ liệu hóa đơn *@
        @if (Model?.Invoice == null && TempData["ErrorMessage"] != null)
        {
            <div class="retro-alert retro-alert-danger"><div class="retro-alert-content">@TempData["ErrorMessage"]</div></div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="retro-alert retro-alert-success"><div class="retro-alert-content">@TempData["SuccessMessage"]</div></div>
        }

        @* Thông tin đăng ký *@
        @if (Model?.Registration != null)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="retro-card">
                        <div class="retro-card-header"><strong><i class="fas fa-user-graduate"></i> Thông tin đăng ký</strong></div>
                        <div class="retro-card-body">
                            <div><strong>Mã đăng ký:</strong> @Model.Registration.RegistrationCode</div>
                            <div><strong>Ngày đăng ký:</strong> @Model.Registration.RegistrationDate?.ToString("dd/MM/yyyy")</div>
                            <div><strong>Trạng thái:</strong>
                                <span class="retro-badge @GetStatusBadgeClass(Model.Registration.Status)">@Model.Registration.Status</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="retro-card">
                        <div class="retro-card-header"><strong><i class="fas fa-chalkboard-teacher"></i> Thông tin khóa học</strong></div>
                        <div class="retro-card-body">
                            <div><strong>Khóa học:</strong> @Model.Registration.CourseName</div>
                            <div><strong>Lớp:</strong> @Model.Registration.ClassName</div>
                            <div><strong>Thời gian học:</strong> @Model.Registration.StudyDate?.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Thông tin hóa đơn *@
        @if (Model?.Invoice != null)
        {
            <div class="retro-card mb-4">
                <div class="retro-card-header">
                    <strong><i class="fas fa-receipt"></i> Thông tin hóa đơn</strong>
                    @if (Model.Signature != null && Model.Signature.IsSigned)
                    {
                        <span class="float-end">
                            @if (Model.Signature.IsValid)
                            {
                                <span class="badge bg-success"><i class="fas fa-shield-alt"></i> Đã ký số (Hợp lệ)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fas fa-exclamation-triangle"></i> Đã ký số (Không hợp lệ)</span>
                            }
                        </span>
                    }
                </div>
                <div class="retro-card-body">
                    <div class="row g-3">
                        <div class="col-md-4"><strong>Mã hóa đơn:</strong> @Model.Invoice.InvoiceCode</div>
                        <div class="col-md-4"><strong>Ngày tạo:</strong> @Model.Invoice.CreatedDate?.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-md-4"><strong>Hạn thanh toán:</strong> @Model.Invoice.DueDate?.ToString("dd/MM/yyyy")</div>
                        <div class="col-md-4"><strong>Số tiền:</strong> <span class="text-primary fw-bold">@Model.Invoice.Amount.ToString("N0") đ</span></div>
                        <div class="col-md-4"><strong>Trạng thái:</strong> <span class="retro-badge @GetInvoiceStatusBadgeClass(Model.Invoice.Status)">@Model.Invoice.Status</span></div>
                        <div class="col-md-4">
                            @if (Model.Invoice.DueDate.HasValue)
                            {
                                var daysLeft = (Model.Invoice.DueDate.Value - DateTime.Now).Days;
                                if (daysLeft > 0)
                                {
                                    <strong>Còn lại:</strong> <span class="text-warning">@daysLeft ngày</span>
                                }
                                else if (daysLeft == 0)
                                {
                                    <strong class="text-danger">Đến hạn hôm nay!</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">Quá hạn @(-daysLeft) ngày</strong>
                                }
                            }
                        </div>
                    </div>

                    @* Nút Thanh toán chỉ hiển thị khi đã ký số và chưa thanh toán *@
                    @if (Model.Signature?.IsSigned == true && !string.Equals(Model.Invoice.Status, "Đã thanh toán", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="mt-3">
                            <a class="btn btn-success" asp-controller="Student" asp-action="Pay" asp-route-registrationId="@Model.Invoice.RegistrationId">
                                <i class="fas fa-credit-card"></i> Thanh toán
                            </a>
                        </div>
                    }
                </div>
            </div>

            @* Thông tin chữ ký số: chỉ hiển thị tình trạng, không cho học viên tự kiểm *@
            <div class="retro-card mb-4">
                <div class="retro-card-header">
                    <strong><i class="fas fa-signature"></i> Thông tin chữ ký số</strong>
                </div>
                <div class="retro-card-body">
                    @if (Model.Signature?.IsSigned == true)
                    {
                        <div class="row g-3">
                            <div class="col-md-12">
                                @if (Model.Signature.IsValid)
                                {
                                    <div class="retro-alert retro-alert-success"><div class="retro-alert-content"><i class="fas fa-check-circle"></i> <strong>Xác thực hợp lệ</strong></div></div>
                                }
                                else
                                {
                                    <div class="retro-alert retro-alert-danger"><div class="retro-alert-content"><i class="fas fa-times-circle"></i> <strong>Chữ ký không hợp lệ</strong></div></div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Signature.SignedBy))
                            {
                                <div class="col-md-6"><strong>Người ký:</strong> @Model.Signature.SignedBy</div>
                            }
                            @if (Model.Signature.SignedDate.HasValue)
                            {
                                <div class="col-md-6"><strong>Ngày ký:</strong> @Model.Signature.SignedDate?.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Signature.Algorithm))
                            {
                                <div class="col-md-6"><strong>Thuật toán:</strong> @Model.Signature.Algorithm</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="retro-alert retro-alert-warning"><div class="retro-alert-content"><i class="fas fa-exclamation-circle"></i> <strong>Hóa đơn chưa được ký số</strong></div></div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="retro-alert retro-alert-info"><div class="retro-alert-content"><i class="fas fa-info-circle"></i> Chưa có hóa đơn cho đăng ký này.</div></div>
        }

        <div class="text-center mt-4">
            <a class="btn btn-outline-secondary" asp-controller="Student" asp-action="MyRegistrations">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Đã duyệt" => "retro-badge-success",
            "Đã từ chối" => "retro-badge-danger",
            "Chờ duyệt" => "retro-badge-warning",
            _ => "retro-badge-secondary"
        };
    }
    
    private string GetInvoiceStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Đã thanh toán" => "retro-badge-success",
            "Quá hạn" => "retro-badge-danger",
            "Chưa thanh toán" => "retro-badge-warning",
            _ => "retro-badge-secondary"
        };
    }
}
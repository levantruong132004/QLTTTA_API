@model QLTTTA_WEB.Models.StudentInvoiceDetailViewModel
@{
    ViewData["Title"] = "Thanh toán hóa đơn";
}

<div class="retro-card corner-decorated">
    <div class="retro-card-header text-center">
        <h2 class="retro-card-title"><i class="fas fa-credit-card"></i> Xác nhận thanh toán</h2>
    </div>
    <div class="retro-card-body">
        @if (Model?.Invoice == null)
        {
            <div class="retro-alert retro-alert-danger"><div class="retro-alert-content">Không tìm thấy hóa đơn để thanh toán.</div></div>
        }
        else
        {
            <div class="retro-card mb-3">
                <div class="retro-card-header"><strong><i class="fas fa-receipt"></i> Thông tin hóa đơn</strong></div>
                <div class="retro-card-body">
                    <div class="row g-3">
                        <div class="col-md-4"><strong>Mã hóa đơn:</strong> @Model.Invoice.InvoiceCode</div>
                        <div class="col-md-4"><strong>Ngày tạo:</strong> @Model.Invoice.CreatedDate?.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-md-4"><strong>Hạn thanh toán:</strong> @Model.Invoice.DueDate?.ToString("dd/MM/yyyy")</div>
                        <div class="col-md-4"><strong>Số tiền:</strong> <span class="text-primary fw-bold">@Model.Invoice.Amount.ToString("N0") đ</span></div>
                        <div class="col-md-4"><strong>Trạng thái hiện tại:</strong> @Model.Invoice.Status</div>
                    </div>
                </div>
            </div>

            @if (Model?.Registration != null)
            {
                <div class="retro-card mb-3">
                    <div class="retro-card-header"><strong><i class="fas fa-user"></i> Học viên</strong></div>
                    <div class="retro-card-body">
                        <div class="row g-3">
                            <div class="col-md-4"><strong>Email:</strong> @Model.Registration.Email</div>
                            <div class="col-md-4"><strong>SĐT:</strong> @Model.Registration.PhoneNumber</div>
                            <div class="col-md-4"><strong>Mã đăng ký:</strong> @Model.Registration.RegistrationCode</div>
                            <div class="col-md-6"><strong>Khóa học:</strong> @Model.Registration.CourseName</div>
                            <div class="col-md-6"><strong>Lớp:</strong> @Model.Registration.ClassName</div>
                        </div>
                    </div>
                </div>
            }

            @if (Model?.Signature?.IsSigned == true)
            {
                <div class="retro-card mb-3">
                    <div class="retro-card-header"><strong><i class="fas fa-signature"></i> Chữ ký số</strong></div>
                    <div class="retro-card-body">
                        <div class="row g-3">
                            <div class="col-md-4"><strong>Trạng thái:</strong> @(Model.Signature.IsValid ? "Hợp lệ" : "Không hợp lệ")</div>
                            <div class="col-md-4"><strong>Người ký:</strong> @Model.Signature.SignedBy</div>
                            <div class="col-md-4"><strong>Ngày ký:</strong> @Model.Signature.SignedDate?.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>
            }

            <form asp-controller="Student" asp-action="ConfirmPay" method="post" class="retro-card mt-3">
                @Html.AntiForgeryToken()
                <div class="retro-card-header"><strong><i class="fas fa-money-bill"></i> Xác nhận thanh toán</strong></div>
                <div class="retro-card-body">
                    <input type="hidden" name="registrationId" value="@Model.Invoice.RegistrationId" />
                    <input type="hidden" name="invoiceId" value="@Model.Invoice.InvoiceId" />

                    <div class="retro-alert retro-alert-warning mb-3">
                        <div class="retro-alert-content">
                            <h5><i class="fas fa-exclamation-triangle"></i> Lưu ý quan trọng</h5>
                            <ul class="mb-0">
                                <li>Vui lòng <strong>hoàn tất thanh toán</strong> trước khi nhấn nút xác nhận</li>
                                <li>Phương thức: <strong>Chuyển khoản ngân hàng</strong></li>
                                <li><strong>Ngân hàng thụ hưởng:</strong> <span class="text-primary">HDBank</span></li>
                                <li><strong>Số tài khoản:</strong> <span class="text-primary">215704070010285</span></li>
                                <li>Số tiền: <strong class="text-danger">@Model.Invoice.Amount.ToString("N0") đ</strong></li>
                                <li>Nội dung CK: <strong>@Model.Invoice.InvoiceCode</strong></li>
                            </ul>
                        </div>
                    </div>

                    <div class="retro-alert retro-alert-info">
                        <div class="retro-alert-content">
                            <i class="fas fa-info-circle"></i> Sau khi nhấn xác nhận, hệ thống sẽ gửi thông báo đến kế toán để xác minh thanh toán của bạn.
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-success btn-lg w-100 mb-2" 
                                onclick="return confirm('Bạn xác nhận đã hoàn tất thanh toán?')">
                            <i class="fas fa-check-circle"></i> Gửi yêu cầu xác nhận
                        </button>
                        <a class="btn btn-outline-secondary w-100" asp-controller="Student" asp-action="ViewInvoice" 
                           asp-route-registrationId="@Model.Invoice.RegistrationId">
                            <i class="fas fa-arrow-left"></i> Quay lại hóa đơn
                        </a>
                    </div>
                </div>
            </form>
        }
    </div>
</div>

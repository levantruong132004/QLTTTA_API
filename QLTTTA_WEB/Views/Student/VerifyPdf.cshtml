@{
    ViewData["Title"] = "Kiểm tra tính toàn vẹn hóa đơn PDF";
}
<div class="retro-card corner-decorated">
    <div class="retro-card-header text-center">
        <h2 class="retro-card-title"><i class="fas fa-shield-alt"></i> Kiểm tra tính toàn vẹn hóa đơn PDF</h2>
        <p class="text-muted mb-0">Xác minh file PDF bạn nhận được có bị thay đổi hay không</p>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="alert" style="margin-bottom: 20px; border-left: 5px solid #28a745;">
                <h4 class="alert-heading"><i class="fas fa-check-circle"></i> File PDF toàn vẹn</h4>
                <hr>
                <p class="mb-0" style="font-size: 16px; font-weight: 500;">@TempData["SuccessMessage"]</p>
                <p class="mt-2 mb-0 text-muted">File PDF này khớp với bản gốc trong hệ thống. Bạn có thể yên tâm sử dụng.</p>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert" style="margin-bottom: 20px; border-left: 5px solid #dc3545;">
                <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> Cảnh báo: File PDF đã bị thay đổi</h4>
                <hr>
                <p class="mb-0" style="font-size: 16px; font-weight: 500;">@TempData["ErrorMessage"]</p>
                <p class="mt-2 mb-0 text-muted">File PDF này không khớp với bản gốc. Có thể đã bị chỉnh sửa hoặc hư hỏng.</p>
            </div>
        }

        <div class="alert alert-info" role="alert">
            <h5><i class="fas fa-info-circle"></i> Hướng dẫn sử dụng</h5>
            <ol class="mb-0">
                <li>Nhập <strong>Mã hóa đơn (Invoice ID)</strong> - Tìm trong email hoặc trang "Đăng ký của tôi"</li>
                <li>Chọn <strong>file PDF</strong> mà bạn đã tải về từ email</li>
                <li>Nhấn <strong>"Kiểm tra"</strong> để xác minh tính toàn vẹn</li>
            </ol>
        </div>

        <form asp-controller="Student" asp-action="VerifyPdfUpload" method="post" enctype="multipart/form-data" class="retro-card">
            <div class="retro-card-header"><strong><i class="fas fa-upload"></i> Thông tin kiểm tra</strong></div>
            <div class="retro-card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>Mã hóa đơn (Invoice ID)</strong> <span class="text-danger">*</span></label>
                    <input type="number" name="invoiceId" class="form-control" placeholder="Ví dụ: 123" required min="1" />
                    <div class="form-text">
                        <i class="fas fa-lightbulb"></i> Tìm mã hóa đơn trong email hoặc tại trang 
                        <a asp-controller="Student" asp-action="MyRegistrations">Đăng ký của tôi</a>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label"><strong>File PDF hóa đơn</strong> <span class="text-danger">*</span></label>
                    <input type="file" name="pdf" accept="application/pdf,.pdf" class="form-control" required />
                    <div class="form-text">
                        <i class="fas fa-file-pdf"></i> Chọn file PDF mà kế toán đã gửi qua email
                    </div>
                </div>
                
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="fas fa-search"></i> Kiểm tra tính toàn vẹn
                </button>
            </div>
        </form>

        @if (TempData["VerifyDetail"] != null)
        {
            <div class="retro-card mt-3">
                <div class="retro-card-header"><strong><i class="fas fa-info-circle"></i> Chi tiết kỹ thuật</strong></div>
                <div class="retro-card-body">
                    <pre style="white-space:pre-wrap; background: #f8f9fa; padding: 15px; border-radius: 5px; font-size: 13px;">@TempData["VerifyDetail"]</pre>
                </div>
            </div>
        }

        <div class="retro-card mt-3" style="background: #f8f9fa;">
            <div class="retro-card-body">
                <h5><i class="fas fa-question-circle"></i> Cách thức hoạt động</h5>
                <p class="mb-2">Hệ thống sử dụng <strong>hàm băm SHA-256</strong> để kiểm tra tính toàn vẹn:</p>
                <ol class="mb-0">
                    <li><strong>Khi tạo PDF:</strong> Hệ thống tính hash của file và lưu vào database</li>
                    <li><strong>Khi kiểm tra:</strong> Tính hash của file bạn upload và so sánh với hash đã lưu</li>
                    <li><strong>Kết quả:</strong> Nếu 2 hash giống nhau → File toàn vẹn, ngược lại → File đã bị thay đổi</li>
                </ol>
            </div>
        </div>

        <div class="text-center mt-3">
            <a class="btn btn-outline-secondary" asp-controller="Student" asp-action="MyRegistrations">
                <i class="fas fa-arrow-left"></i> Quay lại đăng ký của tôi
            </a>
        </div>
    </div>
</div>

@model List<QLTTTA_WEB.Models.StudentRegistrationViewModel>
@{
    ViewData["Title"] = "Đơn đăng ký của tôi";
}

<div class="retro-card corner-decorated">
    <div class="retro-card-header text-center">
        <h2 class="retro-card-title"><i class="fas fa-file-alt"></i> Đơn đăng ký của tôi</h2>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="retro-alert retro-alert-success"><div class="retro-alert-content">@TempData["SuccessMessage"]</div></div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Mã đăng ký</th>
                            <th>Ngày đăng ký</th>
                            <th>Khóa học</th>
                            <th>Lớp</th>
                            <th>Trạng thái</th>
                            <th>Hóa đơn</th>
                            <th>Chữ ký số</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in Model)
                        {
                            <tr>
                                <td><strong>@reg.RegistrationCode</strong></td>
                                <td>@reg.RegistrationDate?.ToString("dd/MM/yyyy")</td>
                                <td>@reg.CourseName</td>
                                <td>@reg.ClassName</td>
                                <td>
                                    <span class="retro-badge @GetStatusBadgeClass(reg.Status)">
                                        @reg.Status
                                    </span>
                                </td>
                                <td>
                                    @if (reg.HasInvoice)
                                    {
                                        <div>
                                            <i class="fas fa-file-invoice text-success"></i>
                                            <strong>@reg.InvoiceCode</strong>
                                        </div>
                                        <small class="text-muted">@reg.InvoiceStatus</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="fas fa-minus-circle"></i> Chưa có
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (reg.HasInvoice)
                                    {
                                        @if (reg.HasDigitalSignature)
                                        {
                                            <span class="text-success">
                                                <i class="fas fa-shield-alt"></i> Đã ký số
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-warning">
                                                <i class="fas fa-exclamation-triangle"></i> Chưa ký
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (reg.HasInvoice)
                                    {
                                        <div class="btn-group">
                                            <a class="btn btn-sm btn-primary" 
                                               asp-controller="Student" 
                                               asp-action="ViewInvoice" 
                                               asp-route-registrationId="@reg.RegistrationId">
                                                <i class="fas fa-eye"></i> Xem hóa đơn
                                            </a>
                                            <a class="btn btn-sm btn-outline-secondary" 
                                               asp-controller="Student" 
                                               asp-action="VerifyPdf">
                                                <i class="fas fa-check-circle"></i> Kiểm tra xác thực
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled>
                                            <i class="fas fa-ban"></i> Chưa có hóa đơn
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center">
                <div class="retro-alert retro-alert-info">
                    <div class="retro-alert-content">
                        <i class="fas fa-info-circle"></i> Bạn chưa có đơn đăng ký nào.
                    </div>
                </div>
                <div class="mt-3">
                    <a class="btn btn-primary" asp-controller="Student" asp-action="Courses">
                        <i class="fas fa-plus-circle"></i> Đăng ký khóa học mới
                    </a>
                </div>
            </div>
        }

        <!-- Thống kê nhanh -->
        @if (Model != null && Model.Any())
        {
            <div class="vintage-divider"></div>
            
            <div class="row g-3 mt-3">
                <div class="col-md-3">
                    <div class="retro-card text-center">
                        <div class="retro-card-body">
                            <h5>@Model.Count()</h5>
                            <small>Tổng đơn</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="retro-card text-center">
                        <div class="retro-card-body">
                            <h5>@Model.Count(r => r.Status == "Đã duyệt")</h5>
                            <small>Đã duyệt</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="retro-card text-center">
                        <div class="retro-card-body">
                            <h5>@Model.Count(r => r.HasInvoice)</h5>
                            <small>Có hóa đơn</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="retro-card text-center">
                        <div class="retro-card-body">
                            <h5>@Model.Count(r => r.HasDigitalSignature)</h5>
                            <small>Đã ký số</small>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="text-center mt-4">
            <a class="btn btn-outline-secondary" asp-controller="Student" asp-action="Profile">
                <i class="fas fa-user"></i> Quay lại hồ sơ
            </a>
            <a class="btn btn-success" asp-controller="Student" asp-action="Courses">
                <i class="fas fa-plus-circle"></i> Đăng ký khóa học mới
            </a>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Đã duyệt" => "retro-badge-success",
            "Đã từ chối" => "retro-badge-danger",
            "Chờ duyệt" => "retro-badge-warning",
            _ => "retro-badge-secondary"
        };
    }
}
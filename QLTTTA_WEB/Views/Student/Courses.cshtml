@model List<QLTTTA_WEB.Models.PublicCourseItem>
@{
    ViewData["Title"] = "Danh sách khóa học";
}
@* ===================== COURSES LIST VIEW ===================== *@
<div class="retro-card">
    <div class="retro-card-header">
        <h2 class="retro-title"><i class="fas fa-book"></i> Danh sách khóa học</h2>
    </div>
    <div class="retro-card-body">
        <p class="text-muted">Chọn khóa học để gửi yêu cầu đăng ký. Nhân viên sẽ duyệt và sắp lớp.</p>
        @* ===================== DESKTOP TABLE (ẩn trên mobile) ===================== *@
        <table class="table table-striped align-middle d-none d-md-table">
            <thead>
                <tr>
                    <th>Mã khóa học</th>
                    <th>Tên khóa học</th>
                    <th>Mô tả</th>
                    <th>Học phí</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CourseCode</td>
                        <td>@c.CourseName</td>
                        <td>@c.Description</td>
                        <td><span class="badge bg-secondary">@c.StandardFee</span></td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="OpenClasses" asp-controller="Student"
                                asp-route-courseCode="@c.CourseCode">
                                <i class="fas fa-users"></i> Chọn lớp
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @* ===================== MOBILE CARD LIST (ẩn trên desktop) ===================== *@
        <div class="d-md-none">
            @foreach (var c in Model)
            {
                <div class="retro-card mb-3" style="border:2px solid var(--vintage-brown);">
                    <div class="retro-card-body" style="padding:0.75rem;">
                        <h5 style="margin:0 0 0.5rem 0; font-size:1rem;" class="text-uppercase"><i class="fas fa-book"></i>
                            @c.CourseName</h5>
                        <div style="font-size:0.85rem; color:var(--vintage-gray);">Mã: <strong>@c.CourseCode</strong></div>
                        <div style="font-size:0.85rem; margin-top:0.25rem;">@c.Description</div>
                        <div style="margin-top:0.5rem; font-size:0.85rem;">Học phí: <span
                                class="badge bg-secondary">@c.StandardFee</span></div>
                        <a class="btn btn-sm btn-outline-primary w-100" asp-action="OpenClasses" asp-controller="Student"
                            asp-route-courseCode="@c.CourseCode">
                            <i class="fas fa-users"></i> Chọn lớp
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
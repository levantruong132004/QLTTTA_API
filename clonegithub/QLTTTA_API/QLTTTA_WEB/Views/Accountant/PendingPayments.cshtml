@model List<QLTTTA_WEB.Models.PendingPaymentViewModel>
@{
    ViewData["Title"] = "Quản lý thanh toán chờ xác nhận";
}

<div class="retro-card corner-decorated">
    <div class="retro-card-header text-center">
        <h2 class="retro-card-title">
            <i class="fas fa-bell"></i> Thanh toán chờ xác nhận
            @if (Model.Any())
            {
                <span class="badge bg-warning text-dark ms-2">@Model.Count</span>
            }
        </h2>
    </div>
    <div class="retro-card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="retro-alert retro-alert-success">
                <div class="retro-alert-content">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="retro-alert retro-alert-danger">
                <div class="retro-alert-content">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="retro-alert retro-alert-info">
                <div class="retro-alert-content">
                    <i class="fas fa-info-circle"></i> <strong>Không có yêu cầu thanh toán nào đang chờ xác nhận</strong>
                    <p class="mb-0 mt-2">Tất cả các thanh toán đã được xử lý.</p>
                </div>
            </div>
        }
        else
        {
            <div class="retro-alert retro-alert-warning mb-4">
                <div class="retro-alert-content">
                    <i class="fas fa-exclamation-triangle"></i> <strong>Lưu ý:</strong> Vui lòng kiểm tra kỹ thông tin chuyển khoản trước khi xác nhận thanh toán!
                </div>
            </div>

            <div class="table-responsive">
                <table class="retro-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag me-2"></i>STT</th>
                            <th><i class="fas fa-file-invoice me-2"></i>Mã hóa đơn</th>
                            <th><i class="fas fa-user me-2"></i>Học viên</th>
                            <th><i class="fas fa-book me-2"></i>Khóa học</th>
                            <th><i class="fas fa-money-bill-wave me-2"></i>Số tiền</th>
                            <th><i class="fas fa-calendar me-2"></i>Ngày tạo</th>
                            <th><i class="fas fa-cogs me-2"></i>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var payment = Model[i];
                            <tr>
                                <td><strong>@(i + 1)</strong></td>
                                <td>
                                    <span class="retro-badge retro-badge-primary">@payment.InvoiceCode</span>
                                    <br />
                                    <small class="text-muted">Đăng ký: @payment.RegistrationCode</small>
                                </td>
                                <td>
                                    <strong>@payment.StudentName</strong>
                                </td>
                                <td>@payment.CourseName</td>
                                <td>
                                    <span class="text-danger fw-bold">@payment.Amount.ToString("N0") đ</span>
                                </td>
                                <td>@payment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <form asp-controller="Accountant" asp-action="ConfirmPayment" method="post" 
                                          style="display: inline;"
                                          onsubmit="return confirm('⚠️ Bạn đã kiểm tra kỹ thông tin chuyển khoản?\n\nHọc viên: @payment.StudentName\nSố tiền: @payment.Amount.ToString("N0") đ\n\nXác nhận thanh toán?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="invoiceId" value="@payment.InvoiceId" />
                                        <button type="submit" class="btn-retro btn-retro-success btn-retro-sm">
                                            <i class="fas fa-check-circle"></i> Xác nhận
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4 text-center">
                <a class="btn btn-outline-secondary" asp-controller="Accountant" asp-action="Index">
                    <i class="fas fa-arrow-left"></i> Quay lại trang chủ
                </a>
            </div>
        }
    </div>
</div>

<style>
    .retro-badge-primary {
        background-color: var(--vintage-brown);
        color: var(--vintage-cream);
        padding: 4px 8px;
        border-radius: 3px;
        font-weight: bold;
    }
    
    .badge {
        font-size: 0.9rem;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .retro-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .retro-table thead th {
        background-color: var(--vintage-brown);
        color: var(--vintage-cream);
        padding: 12px;
        text-align: left;
        border: 2px solid var(--vintage-dark-brown);
    }

    .retro-table tbody td {
        padding: 10px 12px;
        border: 1px solid var(--vintage-brown);
        background-color: var(--vintage-cream);
    }

    .retro-table tbody tr:hover {
        background-color: #f5f0e8;
    }

    @@media (max-width: 768px) {
        .retro-table {
            font-size: 0.85rem;
        }
        
        .retro-table thead th,
        .retro-table tbody td {
            padding: 8px;
        }
    }
</style>